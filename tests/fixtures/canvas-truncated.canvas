      "x" : 1304,
      "y" : 2948
    },
    {
      "height" : 120,
      "id" : "ac42f671fa0138d5",
      "text" : "Republican\n*republicans*\n\n1. n. 共和党人\n2. adj. 共和党的\n3. 共和的",
      "type" : "text",
